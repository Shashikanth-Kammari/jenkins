pipeline {
    agent {
        label 'Agent-1'
    }
    stages {
        stage('Build') {
            steps {
                echo 'Building...'
            }
        }
        stage('Test') {
            steps {
                echo 'Testing...'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying...'
            }
        }
    }
    post {
        always {
            echo 'This always runs, regardless of the build result.'
        }
        success {
            echo 'Pipeline succeeded!'
            // Add notification (e.g., Slack, Email) here
        }
        failure {
            echo 'Pipeline failed!'
            // Add notification (e.g., Slack, Email) here
        }
    }
}